# KidneyScan AI — files that must NEVER be pushed to GitHub
# Code + docs + small configs only. Data and trained weights stay local.

# --- Python ---
.venv/
.venv-*/
venv/
venv-*/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

# --- Node / Next.js ---
node_modules/
.next/
dist/
build/
out/

